[Unit]
Description=Palimpsest memory server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=RUST_LOG=info
Environment=PALIMPSEST_HOST=127.0.0.1
Environment=PALIMPSEST_PORT=3111
ExecStart=/usr/local/bin/palimpsest --host ${PALIMPSEST_HOST} --port ${PALIMPSEST_PORT} --data-dir /var/lib/palimpsest
Restart=on-failure
RestartSec=5
StateDirectory=palimpsest
WorkingDirectory=/usr/local/share/palimpsest
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
