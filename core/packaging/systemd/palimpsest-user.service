[Unit]
Description=Palimpsest memory server
After=default.target

[Service]
Type=simple
Environment=RUST_LOG=info
Environment=PALIMPSEST_HOST=127.0.0.1
Environment=PALIMPSEST_PORT=3111
ExecStart=%h/.local/bin/palimpsest --host ${PALIMPSEST_HOST} --port ${PALIMPSEST_PORT} --data-dir %h/.palimpsest
Restart=on-failure
RestartSec=5
WorkingDirectory=%h/.local/share/palimpsest

[Install]
WantedBy=default.target
