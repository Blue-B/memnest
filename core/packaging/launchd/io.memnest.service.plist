<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.memnest.service</string>
  <key>ProgramArguments</key>
  <array>
    <string>__MEMNEST_BIN__</string><string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>__MEMNEST_PORT__</string><string>--data-dir</string><string>__MEMNEST_DATA__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__MEMNEST_LOGS__/service.log</string>
  <key>StandardErrorPath</key><string>__MEMNEST_LOGS__/service-error.log</string>
</dict>
</plist>
