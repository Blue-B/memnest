{
  "name": "pi-memnest",
  "version": "0.2.0",
  "description": "Memnest memory bridge for pi — exposes the canonical memory_* and secret_* tools backed by a local memnest server",
  "type": "module",
  "main": "./dist/index.mjs",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "extension",
    "memory",
    "memnest",
    "mcp",
    "ai-memory",
    "rag",
    "sqlite",
    "bm25",
    "vector-search"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "dist"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./dist/index.mjs"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node20 --external:@earendil-works/pi-coding-agent --external:@mariozechner/pi-coding-agent --outfile=dist/index.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "smoke": "node test/smoke.mjs && node test/auth.mjs && node test/empty-token.mjs && node test/scoped-autocontext.mjs && node test/contract-errors.mjs && node test/autocontext-triggers.mjs",
    "smoke:bun": "bun test/smoke.mjs",
    "e2e": "node test/e2e-mcp.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typebox": "^1.1.39"
  },
  "author": "Blue-B",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blue-B/memnest.git",
    "directory": "pi-extension"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/Blue-B/memnest/issues"
  },
  "homepage": "https://github.com/Blue-B/memnest#readme"
}
